{
  "$schema": "https://raw.githubusercontent.com/nicholasio/tauri-docs/v2/tooling/cli/schema.json",
  "productName": "MiniMax Studio",
  "version": "0.3.0",
  "identifier": "com.minimax.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MiniMax Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "externalBin": [
      "binaries/mmx",
      "binaries/ffmpeg",
      "binaries/node"
    ],
    "resources": [
      "binaries/mmx-cli/**/*"
    ]
  }
}